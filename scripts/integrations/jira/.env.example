# Jira / Confluence / Figma integration
# Copy this file to .env and fill real values locally.
# Do not commit .env.

JIRA_BASE_URL=https://sapp-academy.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=<PROJECT_KEY>

# Optional for Jira Server/Data Center
JIRA_PAT=

CONFLUENCE_URL=https://sapp-academy.atlassian.net/wiki
CONFLUENCE_USERNAME=your-email@company.com
CONFLUENCE_API_TOKEN=your-confluence-api-token
CONFLUENCE_PAGE_ID=<PAGE_ID>
CONFLUENCE_REQUIREMENT_URL=

FIGMA_FILE_URL=
FIGMA_FILE_KEY=
FIGMA_NODE_ID=
FIGMA_API_KEY=

PROJECT_OUTPUT_DIR=outputs/<YOUR_PROJECT>
TASK_KEY=<TASK_KEY>
TASK_OUTPUT_DIR=outputs/<YOUR_PROJECT>/tasks/<TASK_KEY>

# Jira Bug Reporter
# JIRA_STORY_KEY defaults to TASK_KEY when omitted.
JIRA_STORY_KEY=<JIRA_STORY_KEY>
JIRA_DEV_ASSIGNEE=dev@company.com
JIRA_BUG_ISSUE_TYPE=Sub-task

JIRA_TESTCASE_ISSUE_TYPE=Test
JIRA_TESTCASE_PARENT_MODE=auto
JIRA_TESTCASE_DRY_RUN=1
JIRA_TESTCASE_QA_APPROVED=0
JIRA_TESTCASE_DEDUP=1
JIRA_TESTCASE_LABELS=qa-testcase
# Required custom fields khi tạo issue (JSON fieldId -> value). Vài project bắt buộc, vd:
# {"customfield_10039":{"id":"10025"},"customfield_10037":[{"id":"10023"}]}
JIRA_TESTCASE_EXTRA_FIELDS=
