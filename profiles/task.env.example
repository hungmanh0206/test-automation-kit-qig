# ============================================================
# TASK PROFILE TEMPLATE
# Copy file này sang  profiles/<TASK_KEY>/task.env  rồi điền giá trị thật.
#
# Chứa GIÁ TRỊ ĐỘNG theo từng task. Giá trị TĨNH dùng chung (base URL + API key:
# Figma / Confluence / Jira / AIO Tests / HubSpot) để ở .env chung, KHÔNG lặp ở đây.
#
# ⚠️ File task.env THẬT không commit (đã gitignore: `profiles/**/task.env`) vì chứa
#    credential. Chỉ commit file .example này.
#
# Tạo nhanh (khỏi copy tay):
#   node scripts/utils/create_profile.js <TASK_KEY> [--project-output outputs/<YOUR_PROJECT>]
#   → sinh profiles/<TASK_KEY>/task.env từ template này, prefill TASK_KEY + JIRA_STORY_KEY;
#     QA chỉ điền credential + link. KHÔNG ghi đè nếu file đã tồn tại.
#
# Chạy:
#   PowerShell: $env:TASK_ENV='profiles/<TASK_KEY>/task.env'; npm run test:task -- --task <TASK_KEY> --project-output <PROJECT_OUTPUT_DIR>
#   Bash:       TASK_ENV=profiles/<TASK_KEY>/task.env npm run test:task -- --task <TASK_KEY> --project-output <PROJECT_OUTPUT_DIR>
# ============================================================

# --- Scope ---
PROJECT_OUTPUT_DIR=outputs/<YOUR_PROJECT>
TASK_KEY=<TASK_KEY>
TASK_NAME=<Tên module/feature của task>
RUN_ID=

# --- Link tài liệu task (URL đầy đủ; GOOGLE_* nhận URL hoặc ID; trống nếu không dùng) ---
JIRA_STORY_KEY=<TASK_KEY>
JIRA_STORY_URL=<URL Jira story/task>
JIRA_EPIC_URL=
CONFLUENCE_REQUIREMENT_URL=
CONFLUENCE_BRD_URL=
GOOGLE_DOCUMENT_ID=
GOOGLE_SHEET_URL=
FIGMA_FILE_URL=

# --- Jira assignee cho BUG (accountId/email/tên hiển thị; trống = không gán) ---
# Gán theo TẦNG lỗi: bug FE → JIRA_FE_ASSIGNEE, bug BE → JIRA_BE_ASSIGNEE.
JIRA_FE_ASSIGNEE=
JIRA_BE_ASSIGNEE=

# --- Tài khoản OPS/LMS theo task (điền giá trị thật; KHÔNG commit) ---
LMS_USERNAME=
LMS_PASSWORD=
OPS_USERNAME=
OPS_PASSWORD=
OPS_RESTRICTED_USER=
OPS_RESTRICTED_PASS=

# --- API token OPS/LMS theo task (mỗi task/tài khoản một token riêng) ---
OPS_API_TOKEN=
LMS_API_TOKEN=

# --- HubSpot (thường để ở .env chung; chỉ override per-task khi cần) ---
HUBSPOT_PORTAL_ID=
HUBSPOT_ACCESS_TOKEN=

# ── Tầng kiểm dữ liệu DB (§23 DB persistence) — CHỈ ĐIỀN KHI TASK CẦN ────────────────────────────────────
# Khai ở ĐÂY, không ở `.env` chung: DB của task phải khoá trong task.env (luật isolation). `preflight` CHẶN
# khi task khai dùng §23 (dimension_manifest có `db_persistence`, hoặc testcase có tag [DbPersist]) mà thiếu
# bộ khoá này — và nó còn ĐỌC QUYỀN THẬT: user có bất kỳ quyền ghi nào là chặn.
#
# BẮT BUỘC là user READ-ONLY (chỉ SELECT). Không dùng lại account app/DBA: tầng này đọc bản ghi để KHOANH
# TẦNG lỗi, không bao giờ ghi. Quy ước host/bảng/bản đồ cột nằm ở `.agent/config/db.conventions.json`
# (copy từ bản `.example.json` rồi ĐO LẠI trên DB của bạn — bản đồ cột của dự án khác là oracle SAI).
LIB_MASTER_DB_RO_HOST=
LIB_MASTER_DB_RO_PORT=5432
LIB_MASTER_DB_RO_NAME=
LIB_MASTER_DB_RO_USERNAME=
LIB_MASTER_DB_RO_PASSWORD=
