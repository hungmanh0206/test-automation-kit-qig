# Copy file này thành .env.local hoặc .env rồi điền giá trị thật.
# Không commit file chứa secret thật.
#
# KHÔNG PHẢI BIẾN NÀO CŨNG BẮT BUỘC. Đây là điều dễ hiểu nhầm nhất ở file này, và đã gây hiểu nhầm thật
# (SAPP-29229): người nhận kit thấy 79 ô trống nên tưởng phải điền hết mới chạy được. Thực tế code chỉ
# CHẶN đúng hai biến: PROJECT_OUTPUT_DIR và TASK_KEY. Đo được: gỡ sạch mọi biến OPS_ và LMS_ rồi chạy
# `preflight --mode phase1` vẫn exit 0, 0 CHẶN.
#
# Mỗi khối dưới đây gắn nhãn LANE. Lane nào không dùng thì bỏ trống cả khối đó.
#   npm run preflight:lanes                                     xem lane nào đã đủ biến
#   TASK_ENV=profiles/<TASK_KEY>/task.env npm run preflight:lanes   xem theo một task cụ thể
# Khai lane ở .agent/config/env_lanes.json.
#
# LƯU Ý (chạy song song nhiều task): file này chỉ nên giữ GIÁ TRỊ TĨNH dùng chung mọi task
# (Figma/Confluence/Jira/AIO/HubSpot API key + base URL). Giá trị ĐỘNG theo task
# (PROJECT_OUTPUT_DIR, TASK_KEY, link story/confluence/figma cụ thể, tài khoản OPS/LMS)
# đặt trong profiles/<TASK_KEY>/task.env và nạp qua TASK_ENV. Xem QUICKSTART.md (mục Parallel Story Safety).

# Project output
PROJECT_OUTPUT_DIR=outputs/<YOUR_PROJECT>
# TASK_KEY/TASK_OUTPUT_DIR/RUN_ID: khai ở đây CHỈ tiện khi chạy MỘT task. Chạy nhiều task song song thì
# chúng phải nằm ở `profiles/<TASK_KEY>/task.env` (nạp qua TASK_ENV) — để ở .env chung là mở đường cho
# lượt chạy này ăn scope của task trước, đúng thứ luật isolation cấm.
TASK_KEY=<TASK_KEY>
TASK_OUTPUT_DIR=
RUN_ID=

# App/site URLs
# LMS  [lane: phase2-lms] — CHỈ cần khi test chạm LMS. Phase 1 không cần.
LMS_BASE_URL=
LMS_LOGIN_URL=
LMS_USERNAME=
LMS_PASSWORD=
LMS_API_BASE_URL=
LMS_SWAGGER_URL=
# API token LMS — biến ĐỘNG theo task, ưu tiên đặt trong profiles/<TASK_KEY>/task.env; đây chỉ là default chung.
LMS_API_TOKEN=

# OPS  [lane: phase2-ops] — CHỈ cần khi test chạm OPS. Có OPS_API_TOKEN thì KHÔNG cần mật khẩu.
OPS_BASE_URL=
OPS_LOGIN_URL=
OPS_URL=
OPS_USERNAME=
OPS_PASSWORD=
# 2 tài khoản TEST cho security_check (authz matrix + IDOR): role thấp (low) và role cao (high).
# Đặt giá trị thật trong profiles/<TASK_KEY>/task.env (không commit). Thiếu → authz/IDOR = NEEDS_ACCOUNT (không FAIL).
# Khoá localStorage chứa token OPS. Chỉ khai khi app đặt token ở key khác mặc định.
# Đọc bởi tests/fe/support/auth/tokenBroker.ts — trước 18/09/2026 code đọc mà bản mẫu KHÔNG khai.
OPS_TOKEN_LS_KEY=
OPS_API_BASE_URL=
OPS_SWAGGER_URL=
# API token OPS — biến ĐỘNG theo task, ưu tiên đặt trong profiles/<TASK_KEY>/task.env; đây chỉ là default chung.
OPS_API_TOKEN=

# URL feature/module tuỳ project
FEATURE_1_URL=
FEATURE_2_URL=
FEATURE_3_URL=

# Jira  [lane: doc-read + publish-aio + bug-jira] — cần để đọc spec, đẩy testcase, log bug.
JIRA_URL=
JIRA_BASE_URL=
JIRA_USERNAME=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PAT=
JIRA_PROJECT_KEY=
JIRA_EPIC_URL=
JIRA_STORY_URL=
JIRA_STORY_KEY=
JIRA_DEV_ASSIGNEE=
JIRA_FE_ASSIGNEE=
JIRA_BE_ASSIGNEE=
JIRA_BUG_ISSUE_TYPE=Sub-bug
JIRA_SPRINT_FIELD_ID=
# Nguồn testcase cho Phase 2 execute/rerun: aio (MẶC ĐỊNH) hoặc excel.
# excel = chạy thuần từ test-cases/*.xlsx local (dùng khi chưa publish, hoặc muốn offline).
# aio  = execute từ testcase trên AIO Tests: `npm run aio:pull:write -- --story <KEY>` kéo về
#        test-cases/from-aio/*.xlsx TRƯỚC khi chạy (cần AIO_API_TOKEN).
TESTCASE_SOURCE=aio
# Đẩy kết quả execute lên AIO thành Cycle (`npm run aio:push-exec`).
#   confirm (MẶC ĐỊNH) = ở PHASE 2, khi cycle execute conclusive: chạy DRY-RUN trình preview cho QA;
#                        **chỉ tạo thật sau khi QA XÁC NHẬN** (`:apply`). RE-RUN thì TỰ TẠO luôn (không
#                        cần xác nhận) vì là mốc verify rõ ràng.
#   auto  = tạo ngay không cần xác nhận ở mọi nơi (unattended/CI).
#   0     = không bao giờ đẩy (kể cả re-run).
#   Guard chung: dừng rõ ràng nếu thiếu AIO_API_TOKEN; KHÔNG tạo nếu run không conclusive
#   (0 Passed/Failed, toàn Not Run = debug/partial/setup-lỗi) trừ khi --force.
# Tên trạng thái ghi trong testcase-status.json: lấy từ .agent/config/verdict_taxonomy.json (cột `aio`) —
# 1 nguồn duy nhất, script tự map sang ID nội bộ bằng GET /config của AIO.
# RELEASE_VERSION đã BỎ (04/09/2026): đo ra không code/CI nào đọc nó. Version của kit lấy từ
# `package.json` → `npm run version:check` (một nguồn). Đừng khai lại ở env.
JIRA_TESTCASE_QA_APPROVED=0
# Required custom fields khi tạo issue (JSON fieldId -> value). Vài project bắt buộc, vd:
# {"customfield_10039":{"id":"10025"},"customfield_10037":[{"id":"10023"}]}

# Confluence  [lane: doc-read] — thiếu thì mất nguồn spec, không chặn.
CONFLUENCE_URL=
CONFLUENCE_USERNAME=
CONFLUENCE_API_TOKEN=
CONFLUENCE_PAGE_ID=
CONFLUENCE_REQUIREMENT_URL=

# Figma  [lane: doc-read] — thiếu thì mất oracle cho CHỮ hiển thị, không chặn.
FIGMA_FILE_URL=
FIGMA_FILE_KEY=
FIGMA_NODE_ID=
FIGMA_API_KEY=

# HubSpot test account only
HUBSPOT_ENV=test
HUBSPOT_BASE_URL=https://api.hubapi.com
HUBSPOT_UI_DOMAIN=app.hubspot.com
HUBSPOT_PORTAL_ID=
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_MCP_PACKAGE=@hubspot/mcp-server@0.4.0

# Google Sheet
GOOGLE_SPREADSHEET_ID=
GOOGLE_API_KEY=
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=

# Playwright artifacts
PW_TRACE=off
PW_VIDEO=off

# ==========================================================================
# Kho DB UAT — READ-ONLY verify/chẩn đoán (PostgreSQL). CHỈ dùng qua guarded
# client tests/support/setup/db/uatPgClient.ts. KHÔNG import 'pg' ở chỗ khác.
#
# Điền credential của kho UAT. Kho UAT và PROD tách biệt: chỉ cấu hình kho UAT
# ở đây thì client chỉ kết nối đúng kho đó; không điền creds => không truy cập.
# Read-only: chỉ chạy SELECT trong transaction READ ONLY (bảo vệ kho UAT khỏi
# ghi nhầm). Nên dùng DB user chỉ có quyền CONNECT + SELECT (least-privilege).
# Vai trò: oracle PHỤ (field trống do FE hay BE? dữ liệu có persist không?).
#    KHÔNG dùng dựng state, KHÔNG phải evidence Jira, KHÔNG thay oracle từ spec.
#    PII đọc ra phải mask trong report, không export file (org rule bảo mật).
# ==========================================================================
LIB_MASTER_DB_HOST=
LIB_MASTER_DB_PORT=5432
LIB_MASTER_DB_NAME=
LIB_MASTER_DB_USERNAME=
LIB_MASTER_DB_PASSWORD=
# Tùy chọn: giới hạn host được kết nối (danh sách phẩy). Bỏ trống => không giới hạn.
LIB_MASTER_DB_ALLOWED_HOSTS=
# Tùy chọn: chặn host/dbname khớp mẫu (danh sách phẩy). Bỏ trống => không áp.
LIB_MASTER_DB_DENY_HOST_PATTERNS=
# true nếu kho UAT yêu cầu SSL.
LIB_MASTER_DB_SSL=false
# Timeout mỗi query (ms) để không nện DB UAT chung.
LIB_MASTER_DB_STATEMENT_TIMEOUT_MS=5000

# ─── Sao lưu knowledge (BẮT BUỘC nếu dùng knowledge/) ───────────────────────────────────────────────
# knowledge/{domain,system,decisions,setup_recipes,environment,locators} + bug_tc_map.json là thứ DUY NHẤT
# trong kit KHÔNG nạp lại được từ nguồn máy (bugs/ thì learn:bugs:apply lấy lại từ Jira được). Chúng bị
# gitignore nên tồn tại trên ĐÚNG MỘT máy. Mối nguy thật không phải hỏng ổ mà là TAI NẠN GIT: đổi nhánh /
# git clean xoá file gitignored — đã xảy ra thật (mất knowledge/, phải git restore 87 file).
# Đích PHẢI ngoài repo; script từ chối ghi vào trong repo. Chạy: npm run knowledge:backup
KNOWLEDGE_BACKUP_DIR=

# ─── AIO Tests (công cụ test-management của kit) ───────────────────────────────────────────────
# Token tạo trong Jira → AIO Tests. Xác thực bằng header `Authorization: AioAuth <token>`.
AIO_API_TOKEN=
AIO_PROJECT_KEY=            # để trống thì dùng JIRA_PROJECT_KEY
AIO_BASE_URL=               # mặc định https://tcms.aiojiraapps.com/aio-tcms/api/v1 (Jira Cloud)
AIO_THROTTLE_MS=            # mặc định 130; tăng nếu API trả body rỗng (rate limit)
#

# --- Google Docs (đọc spec) — credential ĐẶT NGOÀI REPO, khai đường dẫn TUYỆT ĐỐI ---
# `.gitignore` chỉ bảo vệ git, không bảo vệ khi zip/copy/artifact ⇒ `secret:scan` chặn nếu file
# credential nằm trong cây repo. Đặt ở vd `~/.sapp-keys/google_doc/`.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=
GOOGLE_OAUTH_CREDENTIALS_PATH=
GOOGLE_OAUTH_TOKEN_PATH=


# ── ĐÃ XOÁ 04/09/2026 (đo: không code/CI nào đọc) ────────────────────────────────────────────────────────
# RELEASE_VERSION            → version lấy từ package.json (`npm run version:check`)
# OPS_USERNAME/PASSWORD_LOW  → test phân quyền dùng OPS_RESTRICTED_USER/PASS ở profiles/<TASK>/task.env
# OPS_USERNAME/PASSWORD_HIGH → như trên
# PUSH_EXECUTION             → nay dùng `npm run aio:push-exec` (dry-run) rồi `:apply`
# JIRA_TESTCASE_*            → đường publish testcase lên Jira đã BỎ HẲN 20/08/2026; AIO là công cụ duy nhất
#                              (`npm run aio:publish` → `:apply`). Đừng thêm lại.
# Máy canh: tests/fe/infra/env-contract.spec.ts — khoá nào không ai đọc sẽ bị chặn ngay.

# ── Tích hợp Google (gộp từ scripts/integrations/google_*/.env.example ngày 04/09/2026) ───────────────────
# Ba bản mẫu lồng (`jira/`, `google_doc/`, `google_sheet/`) đã XOÁ: bản Jira trùng 21/21 khoá với file này,
# hai bản Google chỉ còn 3 khoá sống nên gộp về đây. Lý do gộp: hai bản mẫu env là hai nguồn SẼ TRÔI khỏi
# nhau — và chúng đã làm hỏng đúng một phép đo (grep "khoá nào được đọc" đếm cả file example, ra 6 khoá chết
# bị tưởng là sống). Máy canh: tests/fe/infra/env-contract.spec.ts (chỉ được có MỘT .env.example).
#
# CƠ CHẾ nạp env theo thư mục VẪN CÒN: mỗi script tích hợp thử `<thư-mục-script>/.env.local` trước rồi mới
# fallback về `.env` gốc. Muốn tách creds cho một tích hợp thì tạo `.env.local` ở thư mục đó — không cần
# `.env.example` riêng.
GOOGLE_DOCUMENT_ID=
TIMEZONE=Asia/Ho_Chi_Minh
# OUTPUT_DIR: ghi đè nơi lưu output của google_doc/google_sheet. Bỏ trống ⇒ dùng <task>/requirements/.
OUTPUT_DIR=

# KHÔNG gộp 3 khoá sau (đo: không code nào đọc): GOOGLE_SHEET_NAME · RESULTS_SHEET_NAME · RESULTS_HEADER_ROW
