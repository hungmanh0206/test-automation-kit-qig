# Copy file này thành .env.local hoặc .env rồi điền giá trị thật.
# Không commit file chứa secret thật.
#
# KHÔNG PHẢI BIẾN NÀO CŨNG BẮT BUỘC. Đây là điều dễ hiểu nhầm nhất ở file này, và đã gây hiểu nhầm thật
# (SAPP-29229): người nhận kit thấy nhiều ô trống nên tưởng phải điền hết mới chạy được. Thực tế code chỉ
# CHẶN đúng hai biến: PROJECT_OUTPUT_DIR và TASK_KEY.
#
# Mỗi khối dưới đây gắn nhãn LANE. Lane nào không dùng thì bỏ trống cả khối đó.
#   npm run preflight:lanes                                     xem lane nào đã đủ biến
#   TASK_ENV=profiles/<TASK_KEY>/task.env npm run preflight:lanes   xem theo một task cụ thể
# Khai lane ở .agent/config/env_lanes.json.
#
# LƯU Ý (chạy song song nhiều task): file này chỉ nên giữ GIÁ TRỊ TĨNH dùng chung mọi task
# (Figma/Backlog API key + base URL). Giá trị ĐỘNG theo task
# (PROJECT_OUTPUT_DIR, TASK_KEY, link story/figma cụ thể)
# đặt trong profiles/<TASK_KEY>/task.env và nạp qua TASK_ENV. Xem QUICKSTART.md (mục Parallel Story Safety).

# Project output
PROJECT_OUTPUT_DIR=outputs/<YOUR_PROJECT>
# TASK_KEY/TASK_OUTPUT_DIR/RUN_ID: khai ở đây CHỈ tiện khi chạy MỘT task. Chạy nhiều task song song thì
# chúng phải nằm ở `profiles/<TASK_KEY>/task.env` (nạp qua TASK_ENV) — để ở .env chung là mở đường cho
# lượt chạy này ăn scope của task trước, đúng thứ luật isolation cấm.
TASK_KEY=<TASK_KEY>
TASK_OUTPUT_DIR=
RUN_ID=

# BACKLOG  [lane: doc-read + bug-BACKLOG] — cần để đọc spec, log bug.
# Migrate Jira→Backlog xong (22/09/2026): scripts/integrations/backlog/* đã đọc BACKLOG_URL/BASE_URL/
# API_KEY/PROJECT_KEY/STORY_KEY/FE_ASSIGNEE/BE_ASSIGNEE/DEV_ASSIGNEE/BUG_ISSUE_TYPE/SPRINT_FIELD_ID.
# USERNAME/EMAIL/PAT/EPIC_URL/STORY_URL vẫn KHÔNG có client đọc — Backlog auth chỉ cần API_KEY, không cần
# username/email/PAT; script resolve story qua STORY_KEY, không qua URL. Xem tests/fe/infra/
# env-contract.spec.ts (DOC_ONLY) để biết lý do từng khoá.
BACKLOG_URL=
BACKLOG_BASE_URL=https://<space>.backlog.com/
BACKLOG_USERNAME=
BACKLOG_EMAIL=
BACKLOG_API_KEY=
BACKLOG_PAT=
BACKLOG_PROJECT_KEY=
BACKLOG_EPIC_URL=
BACKLOG_STORY_URL=
BACKLOG_STORY_KEY=
BACKLOG_DEV_ASSIGNEE=
BACKLOG_FE_ASSIGNEE=
BACKLOG_BE_ASSIGNEE=
BACKLOG_BUG_ISSUE_TYPE=Sub-bug
BACKLOG_SPRINT_FIELD_ID=

# Figma  [lane: doc-read] — thiếu thì mất oracle cho CHỮ hiển thị, không chặn.
FIGMA_FILE_URL=
FIGMA_FILE_KEY=
FIGMA_NODE_ID=
FIGMA_API_KEY=

# Playwright artifacts
PW_TRACE=off
PW_VIDEO=off

# ==========================================================================
# Kho DB UAT — READ-ONLY verify/chẩn đoán (PostgreSQL). CHỈ dùng qua guarded
# client tests/support/setup/db/uatPgClient.ts. KHÔNG import 'pg' ở chỗ khác.
#
# Điền credential của kho UAT. Kho UAT và PROD tách biệt: chỉ cấu hình kho UAT
# ở đây thì client chỉ kết nối đúng kho đó; không điền creds => không truy cập.
# Read-only: chỉ chạy SELECT trong transaction READ ONLY (bảo vệ kho UAT khỏi
# ghi nhầm). Nên dùng DB user chỉ có quyền CONNECT + SELECT (least-privilege).
# Vai trò: oracle PHỤ (field trống do FE hay BE? dữ liệu có persist không?).
#    KHÔNG dùng dựng state, KHÔNG phải evidence BACKLOG, KHÔNG thay oracle từ spec.
#    PII đọc ra phải mask trong report, không export file (org rule bảo mật).
# ==========================================================================
LIB_MASTER_DB_HOST=
LIB_MASTER_DB_PORT=5432
LIB_MASTER_DB_NAME=
LIB_MASTER_DB_USERNAME=
LIB_MASTER_DB_PASSWORD=
# Tùy chọn: giới hạn host được kết nối (danh sách phẩy). Bỏ trống => không giới hạn.
LIB_MASTER_DB_ALLOWED_HOSTS=
# Tùy chọn: chặn host/dbname khớp mẫu (danh sách phẩy). Bỏ trống => không áp.
LIB_MASTER_DB_DENY_HOST_PATTERNS=
# true nếu kho UAT yêu cầu SSL.
LIB_MASTER_DB_SSL=false
# Timeout mỗi query (ms) để không nện DB UAT chung.
LIB_MASTER_DB_STATEMENT_TIMEOUT_MS=5000

# ─── Sao lưu knowledge (BẮT BUỘC nếu dùng knowledge/) ───────────────────────────────────────────────
# knowledge/{domain,system,decisions,setup_recipes,environment,locators} + bug_tc_map.json là thứ DUY NHẤT
# trong kit KHÔNG nạp lại được từ nguồn máy. Chúng bị gitignore nên tồn tại trên ĐÚNG MỘT máy. Mối nguy
# thật không phải hỏng ổ mà là TAI NẠN GIT: đổi nhánh / git clean xoá file gitignored.
# Đích PHẢI ngoài repo; script từ chối ghi vào trong repo. Chạy: npm run knowledge:backup
KNOWLEDGE_BACKUP_DIR=
