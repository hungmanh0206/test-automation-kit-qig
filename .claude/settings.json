{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node scripts/qa/hooks/inject_context.js", "timeout": 30 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "node scripts/qa/hooks/gate_on_write.js", "timeout": 60 }
        ]
      }
    ]
  }
}
